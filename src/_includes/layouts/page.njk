---
layout: layouts/base.njk
---
<section class="page-hero">
  <div class="container">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        {%- if parent %}<li class="breadcrumb-item"><a href="{{ parent.url }}">{{ parent.label }}</a></li>{% endif %}
        <li class="breadcrumb-item active" aria-current="page">{{ crumb or title }}</li>
      </ol>
    </nav>
    {%- if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1>{{ heading or title }}</h1>
    {%- if lead %}<p class="lead">{{ lead }}</p>{% endif %}
  </div>
</section>
{{ content | safe }}
{%- if not hideCta %}
{% include "partials/cta.njk" %}
{%- endif %}
