<section class="cta-band" aria-labelledby="cta-heading">
  <div class="container">
    <div class="cta-inner">
      <div>
        <h2 id="cta-heading">{{ ctaHeading or "Ready to get started?" }}</h2>
        <p class="mb-0">Call the office nearest you, or send us a request and we will call you back.</p>
      </div>
      <div class="cta-actions">
        {%- for o in site.offices %}
        <a class="btn {% if loop.first %}btn-light{% else %}btn-outline-light{% endif %} btn-lg" href="tel:{{ o.phoneHref }}"><i class="fa-solid fa-phone" aria-hidden="true"></i> {{ o.name }} {{ o.phone }}</a>
        {%- endfor %}
        <a class="btn btn-sun btn-lg" href="/contact/#request">Request an appointment</a>
      </div>
    </div>
  </div>
</section>
