---
layout: layouts/page.njk
title: Locations & Contact
crumb: Locations & Contact
permalink: /contact/
eyebrow: Contact us
heading: Locations and contact
lead: "Call the office nearest you, or send an appointment request and our staff will call you back."
description: "Contact Glah Medical Group: Lancaster office, 2207 Columbia Ave, 717-397-7718. Camp Hill office, 797 Poplar Church Rd, 717-737-8400. Request an appointment online."
hideCta: true
pageScripts: ["/assets/js/contact.js", "https://challenges.cloudflare.com/turnstile/v0/api.js"]
---
<section class="section">
  <div class="container">
    <div class="row g-4">
      {%- for o in site.offices %}
      <div class="col-md-6 col-lg-4">
        {% include "partials/office-card.njk" %}
      </div>
      {%- endfor %}
      <div class="col-lg-4">
        <div class="contact-card">
          <span class="feature-icon"><i class="fa-solid fa-envelope" aria-hidden="true"></i></span>
          <h2>Email</h2>
          <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
          <p class="fine-print mb-0">Email is not secure. Please do not send medical details by email or through this website.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint" id="request" aria-labelledby="form-heading" tabindex="-1">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-4">
        <h2 id="form-heading">Request an appointment</h2>
        <p>Tell us how to reach you and what you would like to schedule. Our staff will call you back during office hours to find a time.</p>
        <div class="side-card side-card-alert">
          <p class="mb-0"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> This form is not for emergencies. If you are having a medical emergency, call 911.</p>
        </div>
      </div>
      <div class="col-lg-8">
        <form class="form-card" id="request-form" action="/api/contact" method="post" novalidate>
          <div class="alert-privacy p-3" role="note">
            <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
            <p class="mb-0"><strong>Please do not include medical details.</strong> This form is sent by regular email. We will talk about your health when we call you.</p>
          </div>

          <div id="error-summary" class="error-summary" tabindex="-1" hidden>
            <h2 class="h5">Please fix the following:</h2>
            <ul id="error-list"></ul>
          </div>

          <p class="required-legend">Fields marked <span class="req" aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="f-name">Full name <span class="req" aria-hidden="true">*</span></label>
              <input class="form-control" id="f-name" name="name" autocomplete="name" maxlength="100" required aria-required="true" aria-describedby="f-name-err">
              <div class="invalid-feedback" id="f-name-err"></div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-phone">Phone <span class="req" aria-hidden="true">*</span></label>
              <input class="form-control" id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" required aria-required="true" aria-describedby="f-phone-err">
              <div class="invalid-feedback" id="f-phone-err"></div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-email">Email <span class="optional">(optional)</span></label>
              <input class="form-control" id="f-email" name="email" type="email" autocomplete="email" maxlength="254" aria-describedby="f-email-err">
              <div class="invalid-feedback" id="f-email-err"></div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-office">Preferred office <span class="req" aria-hidden="true">*</span></label>
              <select class="form-select" id="f-office" name="office" required aria-required="true" aria-describedby="f-office-err">
                <option value="">Choose an office</option>
                {%- for o in site.offices %}<option>{{ o.name }}</option>{% endfor %}
              </select>
              <div class="invalid-feedback" id="f-office-err"></div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-service">What would you like to schedule? <span class="req" aria-hidden="true">*</span></label>
              <select class="form-select" id="f-service" name="service" required aria-required="true" aria-describedby="f-service-err">
                <option value="">Choose a service</option>
                {%- for s in contactServices %}<option>{{ s }}</option>{% endfor %}
              </select>
              <div class="invalid-feedback" id="f-service-err"></div>
            </div>
            <div class="col-md-6">
              <fieldset>
                <legend class="form-label fs-6 mb-2">Best time to call <span class="optional">(optional)</span></legend>
                <div class="choice-row">
                  {%- for t in ["Morning", "Afternoon", "Any time"] %}
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="time" id="f-time-{{ loop.index }}" value="{{ t }}"{% if loop.last %} checked{% endif %}>
                    <label class="form-check-label" for="f-time-{{ loop.index }}">{{ t }}</label>
                  </div>
                  {%- endfor %}
                </div>
              </fieldset>
            </div>
            <div class="col-12">
              <label class="form-label" for="f-msg">Anything else we should know? <span class="optional">(optional)</span></label>
              <textarea class="form-control" id="f-msg" name="message" rows="3" maxlength="1000" aria-describedby="f-msg-help"></textarea>
              <div class="form-text" id="f-msg-help">For example, days you are not available. Please no medical details.</div>
            </div>
          </div>

          {# Honeypot: hidden from people and screen readers. Bots that fill it are dropped. #}
          <div class="hp-field" aria-hidden="true">
            <label for="f-website">Leave this field empty</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off">
          </div>

          <div class="cf-turnstile mt-4" data-sitekey="{{ site.turnstileSiteKey }}" data-action="contact" data-theme="light"></div>

          <button class="btn btn-primary btn-lg" type="submit">Send request</button>
          <p id="form-status" class="form-status mt-3 mb-0" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>
