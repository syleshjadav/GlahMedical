{
  // "name" must match the Worker's name in the Cloudflare dashboard (Workers & Pages list).
  "name": "glahmedical",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Run the Worker (not the static files) for the form endpoint.
    "run_worker_first": ["/api/*"]
  },
  // Keep MAIL_TO / MAIL_FROM set in the dashboard when deploying. Secrets are always kept.
  "keep_vars": true,
  "observability": { "enabled": true }
}
