{
	// Cloudflare Worker + static assets for glahmedicalgroup.com
	// Docs: https://developers.cloudflare.com/workers/static-assets/
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Worker's name in the Cloudflare dashboard (Workers & Pages list).
	"name": "glahmedical",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-01",
	// Eleventy builds the site into _site. Cloudflare runs this before deploying.
	"build": {
		"command": "npm run build"
	},
	"assets": {
		"directory": "./_site",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash",
		// The Worker runs first so it can add security headers, the site banner, maintenance mode and the form endpoint.
		"run_worker_first": true
	},
	// Banner and maintenance settings, edited in the Cloudflare dashboard (Storage & Databases > KV).
	// KV namespace titled "glah-settings" (separate from the APMWC site's "SETTINGS" namespace).
	"kv_namespaces": [
		{
			"binding": "SETTINGS",
			"id": "c477dc31498b4f429228563afc0b0687"
		}
	],
	// Request form: at most 5 submissions per minute per visitor IP.
	"ratelimits": [
		{
			"name": "CONTACT_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"vars": {
		// Office inbox(es) that receive form requests. Comma-separate for several.
		"MAIL_TO": "glahmedicalgroup@yahoo.com",
		// Must be an address on the domain verified in Resend (NOT yahoo.com: Yahoo's DMARC rejects it).
		"MAIL_FROM": "Glah Website <appointments@glahmedicalgroup.com>"
		// Secrets (set with `npx wrangler secret put NAME`, never committed):
		//   TURNSTILE_SECRET_KEY    Turnstile secret for the request form
		//   RESEND_API_KEY          Resend API key for sending the request email
		//   MAINTENANCE_BYPASS_KEY  lets staff preview the site while maintenance mode is on
	},
	// Production domains. glahmedicalgroup.com must be a zone in this Cloudflare account.
	// The Worker redirects www.glahmedicalgroup.com to glahmedicalgroup.com.
	"routes": [
		{
			"pattern": "glahmedicalgroup.com",
			"custom_domain": true
		},
		{
			"pattern": "www.glahmedicalgroup.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	// ---------------------------------------------------------------------------
	// DEMO deployment: `npm run deploy:demo` -> https://glahmedical-demo.<your-subdomain>.workers.dev
	// No domain or KV setup needed. A "Preview site" banner shows on every page,
	// search engines are told not to index it, and the form uses Turnstile's test key.
	// ---------------------------------------------------------------------------
	"env": {
		"demo": {
			"name": "glahmedical-demo",
			"ratelimits": [
				{
					"name": "CONTACT_LIMITER",
					"namespace_id": "1002",
					"simple": {
						"limit": 5,
						"period": 60
					}
				}
			],
			"vars": {
				"DEMO_MODE": "true",
				"DEMO_BANNER": "Preview site — not yet live. To schedule, call Lancaster 717-397-7718 or Camp Hill 717-737-8400.",
				"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
				"MAIL_TO": "glahmedicalgroup@yahoo.com",
				"MAIL_FROM": "Glah Website <appointments@glahmedicalgroup.com>"
			}
		}
	}
}